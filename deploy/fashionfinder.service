# /etc/systemd/system/fashionfinder.service
[Unit]
Description=FashionFinder (React + Express)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fashionfinder
Group=fashionfinder
WorkingDirectory=/opt/fashionfinder
EnvironmentFile=/opt/fashionfinder/.env
Environment=NODE_ENV=production
# Own Node.js in /opt/fashionfinder/node, so the system Node (used by other projects) is not touched
ExecStart=/opt/fashionfinder/node/bin/node /opt/fashionfinder/dist-server/index.mjs
Restart=always
RestartSec=3

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/fashionfinder/data

[Install]
WantedBy=multi-user.target
