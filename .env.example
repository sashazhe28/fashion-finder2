# Copy to .env (server) and fill in. Never commit real values.

# --- Server ---
NODE_ENV=production
PORT=3000
# Public address of the site (used for the return URL after payment)
PUBLIC_URL=https://example.com
DATA_DIR=./data

# --- Gemini (server only, never goes to the browser) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
# Optional: second model if the main (preview) one answers 503 "high demand"
GEMINI_FALLBACK_MODEL=
# Optional: custom Gemini API address (gateway/proxy). Empty = https://generativelanguage.googleapis.com
# e.g. Cloudflare AI Gateway: https://gateway.ai.cloudflare.com/v1/<account_id>/<gateway_id>/google-ai-studio
GEMINI_BASE_URL=
# Token of an authenticated Cloudflare AI Gateway (server only)
GEMINI_GATEWAY_TOKEN=

# --- Clerk ---
# Publishable key is public and goes into the frontend build
VITE_CLERK_PUBLISHABLE_KEY=
# Secret key is server only
CLERK_SECRET_KEY=

# --- PostHog (public project token, goes into the frontend build) ---
VITE_PUBLIC_POSTHOG_TOKEN=
# Project is on PostHog US cloud
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- YooKassa (server only) ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Check that notifications come from YooKassa IPs (payment is re-checked via API in any case)
YOOKASSA_CHECK_IP=true
# 54-FZ receipts: set true if receipts are enabled in the shop ("Чеки от ЮKassa" or an online cash register)
YOOKASSA_RECEIPT=false
# 1 = без НДС
YOOKASSA_VAT_CODE=1
# Tax system code (1-6), optional
YOOKASSA_TAX_SYSTEM_CODE=

# --- Limits ---
FREE_GUEST_SEARCHES=2
FREE_USER_SEARCHES=2
GUEST_SEARCHES_PER_IP_PER_DAY=20
MAX_IMAGE_MB=5
ANALYZE_RATE_PER_MINUTE=10
# Optional: secret for signing the guest cookie (generated into DATA_DIR if empty)
GUEST_COOKIE_SECRET=
