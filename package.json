{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "dev:client": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && npm run build:server",
    "start": "NODE_ENV=production node dist-server/index.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --target=node20 --outfile=dist-server/index.mjs"
  },
  "dependencies": {
    "@clerk/clerk-js": "^6.11.0",
    "@clerk/clerk-react": "^5.61.6",
    "@clerk/express": "^2.1.88",
    "@google/genai": "^1.29.0",
    "@posthog/react": "^1.9.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "posthog-js": "^1.372.10",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.27.7",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "engines": {
    "node": ">=20.9"
  }
}
